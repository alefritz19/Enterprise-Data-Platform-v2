# ════════════════════════════════════════════════════════
#  DATA PLATFORM – KONFIGURATION
#  Kopiere diese Datei nach ".env" und fülle sie aus.
#  NIEMALS ".env" in Git committen!
# ════════════════════════════════════════════════════════

# ── PostgreSQL ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=data_platform
DB_USER=postgres
DB_PASSWORD=dein_passwort

# ── Telegram (NUR du – Admin) ────────────────────────────
# Anleitung:
#   1. @BotFather in Telegram → /newbot → Token kopieren
#   2. Bot öffnen → /start senden
#   3. https://api.telegram.org/bot[TOKEN]/getUpdates
#   4. "chat":{"id": 123456789} → das ist deine Chat-ID
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_ADMIN_CHAT_ID=123456789

# ── E-Mail (NUR Kunden – optional) ──────────────────────
# false = keine Kunden-E-Mails
# true  = täglicher Bericht um 08:00 Uhr
EMAIL_ENABLED=false

EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=dein@gmail.com

# Gmail: Google-Konto → Sicherheit → App-Passwörter
# (kein normales Gmail-Passwort!)
EMAIL_SENDER_PASSWORD=xxxx_xxxx_xxxx_xxxx

CLIENT_EMAIL=kunde@firma.de
CLIENT_NAME=Herr Müller

# Power BI Link im Kunden-E-Mail (leer lassen wenn nicht vorhanden)
POWERBI_REPORT_URL=https://app.powerbi.com/view?r=...

# ── Power BI API (optional) ──────────────────────────────
# Ohne diese Werte → CSV-Export statt API-Aktualisierung
POWER_BI_TENANT_ID=
POWER_BI_CLIENT_ID=
POWER_BI_CLIENT_SECRET=
POWER_BI_DATASET_ID=
POWER_BI_GROUP_ID=

# ── Logging & Dashboard-Schutz ───────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/data_platform.log
ADMIN_PIN=local-dev-pin
